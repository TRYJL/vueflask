{"ast":null,"code":"export default {\n  data() {\n    return {\n      file: null,\n      msg: ''\n    };\n  },\n  methods: {\n    handleFile(e) {\n      this.file = e.target.files[0];\n    },\n    uploadFile() {\n      if (!this.file) {\n        this.msg = '请选择文件';\n        return;\n      }\n      const formData = new FormData();\n      formData.append('file', this.file);\n      this.$http.post('/api/upload', formData, {\n        headers: {\n          'Content-Type': 'multipart/form-data'\n        }\n      }).then(res => {\n        if (res.data.success) {\n          this.msg = '上传成功: ' + res.data.filename;\n        } else {\n          this.msg = '上传失败: ' + res.data.message;\n        }\n      }).catch(err => {\n        this.msg = '上传失败: ' + err.response?.data?.message || err.message;\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","file","msg","methods","handleFile","e","target","files","uploadFile","formData","FormData","append","$http","post","headers","then","res","success","filename","message","catch","err","response"],"sources":["src/components/HomePage.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>上传文件</h2>\r\n    <input type=\"file\" @change=\"handleFile\" />\r\n    <button @click=\"uploadFile\">上传</button>\r\n    <p style=\"color: green\">{{ msg }}</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      file: null,\r\n      msg: ''\r\n    }\r\n  },\r\n  methods: {\r\n    handleFile(e) {\r\n      this.file = e.target.files[0]\r\n    },\r\n    uploadFile() {\r\n      if (!this.file) {\r\n        this.msg = '请选择文件'\r\n        return\r\n      }\r\n\r\n      const formData = new FormData()\r\n      formData.append('file', this.file)\r\n\r\n      this.$http.post('/api/upload', formData, {\r\n        headers: {\r\n          'Content-Type': 'multipart/form-data'\r\n        }\r\n      }).then(res => {\r\n        if (res.data.success) {\r\n          this.msg = '上传成功: ' + res.data.filename\r\n        } else {\r\n          this.msg = '上传失败: ' + res.data.message\r\n        }\r\n      }).catch(err => {\r\n        this.msg = '上传失败: ' + err.response?.data?.message || err.message\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAUA;EACAA,KAAA;IACA;MACAC,IAAA;MACAC,GAAA;IACA;EACA;EACAC,OAAA;IACAC,WAAAC,CAAA;MACA,KAAAJ,IAAA,GAAAI,CAAA,CAAAC,MAAA,CAAAC,KAAA;IACA;IACAC,WAAA;MACA,UAAAP,IAAA;QACA,KAAAC,GAAA;QACA;MACA;MAEA,MAAAO,QAAA,OAAAC,QAAA;MACAD,QAAA,CAAAE,MAAA,cAAAV,IAAA;MAEA,KAAAW,KAAA,CAAAC,IAAA,gBAAAJ,QAAA;QACAK,OAAA;UACA;QACA;MACA,GAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAhB,IAAA,CAAAiB,OAAA;UACA,KAAAf,GAAA,cAAAc,GAAA,CAAAhB,IAAA,CAAAkB,QAAA;QACA;UACA,KAAAhB,GAAA,cAAAc,GAAA,CAAAhB,IAAA,CAAAmB,OAAA;QACA;MACA,GAAAC,KAAA,CAAAC,GAAA;QACA,KAAAnB,GAAA,cAAAmB,GAAA,CAAAC,QAAA,EAAAtB,IAAA,EAAAmB,OAAA,IAAAE,GAAA,CAAAF,OAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}