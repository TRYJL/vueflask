{"ast":null,"code":"export default {\n  data() {\n    return {\n      username: '',\n      password: '',\n      msg: ''\n    };\n  },\n  methods: {\n    register() {\n      this.$http.post('/api/register', {\n        username: this.username,\n        password: this.password\n      }).then(res => {\n        if (res.data.success) {\n          this.msg = '注册成功，请登录';\n        } else {\n          this.msg = res.data.message;\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","username","password","msg","methods","register","$http","post","then","res","success","message"],"sources":["src/components/RegisterPage.vue"],"sourcesContent":["<template>\r\n    <div>\r\n      <h2>注册</h2>\r\n      <input v-model=\"username\" placeholder=\"用户名\" />\r\n      <input v-model=\"password\" type=\"password\" placeholder=\"密码\" />\r\n      <button @click=\"register\">注册</button>\r\n      <p style=\"color: red\">{{ msg }}</p>\r\n      <p><router-link to=\"/login\">已有账号？点我登录</router-link></p>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    data() {\r\n      return {\r\n        username: '',\r\n        password: '',\r\n        msg: ''\r\n      }\r\n    },\r\n    methods: {\r\n      register() {\r\n        this.$http.post('/api/register', {\r\n          username: this.username,\r\n          password: this.password\r\n        }).then(res => {\r\n          if (res.data.success) {\r\n            this.msg = '注册成功，请登录'\r\n          } else {\r\n            this.msg = res.data.message\r\n          }\r\n        })\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  "],"mappings":"AAYA;EACAA,KAAA;IACA;MACAC,QAAA;MACAC,QAAA;MACAC,GAAA;IACA;EACA;EACAC,OAAA;IACAC,SAAA;MACA,KAAAC,KAAA,CAAAC,IAAA;QACAN,QAAA,OAAAA,QAAA;QACAC,QAAA,OAAAA;MACA,GAAAM,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAT,IAAA,CAAAU,OAAA;UACA,KAAAP,GAAA;QACA;UACA,KAAAA,GAAA,GAAAM,GAAA,CAAAT,IAAA,CAAAW,OAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDep